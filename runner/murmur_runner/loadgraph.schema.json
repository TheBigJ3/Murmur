{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TheBigJ3/murmur/main/runner/murmur_runner/loadgraph.schema.json",
  "title": "Murmur load graph",
  "description": "The structure of .murmur/loadgraph.json. Rules that span several fields, such as probabilities summing to 1, are checked by murmur_runner.graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "murmur_version",
    "start",
    "session_flags",
    "test_rules",
    "nodes",
    "edges",
    "personas"
  ],
  "properties": {
    "murmur_version": {
      "description": "Version of the murmur-start skill and prompt that produced this file.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "start": {
      "description": "The node every session begins at.",
      "$ref": "#/$defs/nodeName"
    },
    "session_flags": {
      "description": "Flags that belong to a logged-in session. A clear of @session clears all of them.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/flag"
      },
      "uniqueItems": true
    },
    "test_rules": {
      "description": "Existing test credential rules, referenced in nodes as {test:<rule_name>}.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/testRule"
      }
    },
    "headers": {
      "description": "Headers sent on every request, such as a token extracted at login. A header whose placeholders have no value yet is left out.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/nodeName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "description": "Outgoing edges of each node. Each node's p values sum to 1, within 1e-6.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/nodeName"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/edge"
        }
      }
    },
    "personas": {
      "description": "User types. Personas with a share split the users left after fixed counts; their shares sum to 1, within 1e-6.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/persona"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "nodeName": {
      "description": "A node name. exit is reserved for leaving the graph.",
      "allOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "not": {
            "const": "exit"
          }
        }
      ]
    },
    "flag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "flagOrSession": {
      "description": "A flag, or @session for every flag in session_flags.",
      "type": "string",
      "pattern": "^([A-Za-z0-9_.-]+|@session)$"
    },
    "flags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flag"
      },
      "uniqueItems": true
    },
    "clears": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flagOrSession"
      },
      "uniqueItems": true
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "request": {
      "description": "METHOD /path, with {placeholders} in the path.",
      "type": "string",
      "pattern": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) /\\S*$"
    },
    "extracts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "description": "A value from the response body.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "pick"
            ],
            "properties": {
              "path": {
                "description": "JSONPath into the response body.",
                "type": "string",
                "pattern": "^\\$"
              },
              "pick": {
                "enum": [
                  "random",
                  "first"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "unlocks": {
                "description": "Flags set when this extract finds a value, and cleared when it finds none.",
                "$ref": "#/$defs/flags"
              },
              "locks": {
                "description": "Flags cleared when this extract finds a value.",
                "$ref": "#/$defs/flags"
              }
            }
          },
          {
            "description": "The value of a response header, such as a token.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "header"
            ],
            "properties": {
              "header": {
                "description": "The header name, in any case.",
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "required": {
                "type": "boolean"
              },
              "unlocks": {
                "description": "Flags set when this extract finds a value, and cleared when it finds none.",
                "$ref": "#/$defs/flags"
              },
              "locks": {
                "description": "Flags cleared when this extract finds a value.",
                "$ref": "#/$defs/flags"
              }
            }
          }
        ]
      }
    },
    "testRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "source",
        "dev_only"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "generate": {
          "description": "Pattern for a value that triggers the rule: # is a random digit, {rand} a random unique lowercase string, anything else literal.",
          "type": "string",
          "minLength": 1
        },
        "value": {
          "description": "A fixed value, such as an OTP code.",
          "type": "string"
        },
        "source": {
          "description": "file:function that implements the rule.",
          "type": "string"
        },
        "dev_only": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": [
            "generate"
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        },
        {
          "required": [
            "value"
          ],
          "not": {
            "required": [
              "generate"
            ]
          }
        }
      ]
    },
    "skip": {
      "description": "Calls a private Murmur endpoint in place of a step that needs an outside service.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "request",
        "headers"
      ],
      "properties": {
        "reason": {
          "description": "The outside service being skipped.",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {},
        "extract": {
          "$ref": "#/$defs/extracts"
        },
        "sets": {
          "$ref": "#/$defs/flags"
        },
        "clears": {
          "$ref": "#/$defs/clears"
        },
        "account": {
          "$ref": "#/$defs/account"
        },
        "post": {
          "$ref": "#/$defs/post"
        },
        "joins": {
          "description": "Pool groups the session's account joins when this step succeeds, such as a role it grants.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "body": {},
        "extract": {
          "$ref": "#/$defs/extracts"
        },
        "sets": {
          "$ref": "#/$defs/flags"
        },
        "clears": {
          "$ref": "#/$defs/clears"
        },
        "requires": {
          "$ref": "#/$defs/conditions"
        },
        "requires_not": {
          "$ref": "#/$defs/conditions"
        },
        "skip": {
          "$ref": "#/$defs/skip"
        },
        "account": {
          "$ref": "#/$defs/account"
        },
        "post": {
          "$ref": "#/$defs/post"
        },
        "joins": {
          "description": "Pool groups the session's account joins when this step succeeds, such as a role it grants.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to",
        "p",
        "tag"
      ],
      "properties": {
        "to": {
          "description": "A node name, or exit to end the session.",
          "$ref": "#/$defs/identifier"
        },
        "p": {
          "$ref": "#/$defs/probability"
        },
        "tag": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "share": {
          "description": "The part of the users, besides fixed counts, that run this persona.",
          "$ref": "#/$defs/probability"
        },
        "count": {
          "description": "A fixed number of users that always run this persona.",
          "type": "integer",
          "minimum": 1
        },
        "pool": {
          "description": "The pool group whose accounts this persona uses (default: default).",
          "$ref": "#/$defs/identifier"
        },
        "flags": {
          "description": "Flags every session of this persona starts with, such as a role.",
          "$ref": "#/$defs/flags"
        },
        "multipliers": {
          "description": "Scales the probability of every edge with this tag for this persona.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "share"
          ],
          "not": {
            "required": [
              "count"
            ]
          }
        },
        {
          "required": [
            "count"
          ],
          "not": {
            "required": [
              "share"
            ]
          }
        }
      ]
    },
    "account": {
      "description": "An account this step creates. It becomes this session's user at once, and joins the pool once the session sets the ready flag (or at once without one).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "group": {
          "description": "The pool group it joins (default: default).",
          "$ref": "#/$defs/identifier"
        },
        "fields": {
          "description": "The account's fields, such as email and password, usually the same placeholders the request sent.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "ready": {
          "description": "The flag that makes the account usable, such as one set after verification.",
          "$ref": "#/$defs/flag"
        }
      }
    },
    "post": {
      "description": "Values this step puts on the shared board, for other sessions to take with {board:<name>}.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "condition": {
      "description": "A flag, @user (the session has an account), or @in:<group> (the session's account is in that pool group).",
      "type": "string",
      "pattern": "^([A-Za-z0-9_.-]+|@user|@in:[A-Za-z0-9_.-]+)$"
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition"
      },
      "uniqueItems": true
    }
  }
}
